# PostgreSQL connection, used only on the server. URL-encode special characters.
DATABASE_URL="postgresql://gstore:replace-with-local-password@localhost:5432/gstore?schema=public"
# Only needed when using compose.yaml; match the password in DATABASE_URL.
POSTGRES_PASSWORD=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: creates an admin on the first seed. No default admin credentials.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Dedicated disposable PostgreSQL database for integration tests ONLY.
TEST_DATABASE_URL=""
# Browser tests target an already-running app, default http://localhost:3000.
E2E_BASE_URL="http://localhost:3000"
# Optional: chrome or msedge to use an installed browser instead of Playwright Chromium.
E2E_BROWSER_CHANNEL=""
